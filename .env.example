# ============================================================
#  EDVIA — configuration du backend
#  Copiez ce fichier en « .env » puis adaptez les valeurs.
#  Le fichier .env n'est JAMAIS envoyé sur GitHub (voir .gitignore).
# ============================================================

# development | production
NODE_ENV=development

# --- Sécurité -----------------------------------------------------------------
# JWT_SECRET : au moins 32 caractères aléatoires en production (obligatoire).
# SEAL_SECRET : secret du code d'authenticité des bulletins (facultatif ; par défaut dérivé de JWT_SECRET).
#   Si vous le changez, les codes des bulletins déjà imprimés ne seront plus reconnus.
# TRUST_PROXY : nombre de proxys devant le serveur (1 sur Render/Heroku, 0 en local). Sert à lire la vraie adresse IP
#   des visiteurs pour les limites de débit et le blocage des essais de connexion.
# RATE_LIMIT=600        requêtes par minute et par adresse IP
# REGISTER_LIMIT=10     créations d'établissement par heure et par adresse IP
# VERIFY_LIMIT=20       vérifications de bulletin par 10 minutes et par adresse IP

# Port d'écoute du serveur
PORT=3001

# Connexion MongoDB
#  - local :  mongodb://127.0.0.1:27017
#  - Atlas :  mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
# Nom de la base. Laissez vide pour utiliser celui de l'adresse (…mongodb.net/Edvia?…).
# Attention : Atlas distingue majuscules et minuscules (« Edvia » ≠ « edvia »).
DB_NAME=edvia

# Base utilisée UNIQUEMENT par « npm test » (jamais la base ci-dessus). Local par défaut.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017

# Autorise les pages ouvertes sur http://localhost:<port> (n'importe quel port).
# Par défaut : activé en développement, désactivé en production. Mettez true sur un serveur EN LIGNE
# si vous voulez l'utiliser depuis l'application lancée sur votre ordinateur.
# CORS_ALLOW_LOCALHOST=true

# Autres serveurs que l'application servie par CE backend peut contacter (ex. le serveur en ligne,
# quand l'application tourne en local avec VITE_API_URLS=…). Séparés par des virgules.
#   ex. CONNECT_SRC=https://edvia-backend.onrender.com
CONNECT_SRC=

# DNS à utiliser pour joindre MongoDB Atlas. À renseigner si la connexion échoue avec
# « querySrv ECONNREFUSED » (certains réseaux refusent les requêtes DNS SRV de mongodb+srv://).
#   DNS_SERVERS=8.8.8.8,1.1.1.1
DNS_SERVERS=

# Secret de signature des sessions (JWT) — chaîne longue et aléatoire, 32 caractères minimum.
# OBLIGATOIRE en production. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Durée d'une session : 30m, 12h, 7d…
JWT_EXPIRES=12h

# Origines autorisées quand l'application (web, APK, WebView) est servie depuis un AUTRE domaine
# que l'API, séparées par des virgules. Laisser vide si le backend sert lui-même l'application.
#   ex. https://edvia.example.com,https://admin.edvia.example.com
CORS_ORIGIN=
